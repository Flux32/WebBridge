{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["vite/client", "node"],
    "paths": {
      // The bridge pins a protocol release that predates jumper; its declarations must read
