{
  "name": "jumper-stub",
  "private": true,
  "version": "0.0.0",
  "description": "A stub jumper game on JumperBridge and Canvas 2D: checks the shell's jumper mode live before the real engine exists.",
  "type": "module",
  "scripts": {
    "prepare-bridge": "tsc -b ../../webbridge",
    "dev": "npm run prepare-bridge && vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 5182 --strictPort",
    "typecheck": "npm run prepare-bridge && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@omega/webbridge-js": "*",
    "@omega/webbridge-protocol": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.7"
  }
}
