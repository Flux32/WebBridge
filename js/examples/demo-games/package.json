{
  "name": "demo-games",
  "private": true,
  "version": "0.0.0",
  "description": "Demo web games, one per shell game mode: the configurator's «Демо игры» tab shows how each mode's backend plays a round.",
  "type": "module",
  "scripts": {
    "prepare-bridge": "tsc -b ../../webbridge",
    "dev": "npm run prepare-bridge && vite",
    "build": "npm run typecheck && node scripts/build-all.ts",
    "typecheck": "npm run prepare-bridge && tsc -p tsconfig.json",
    "test": "npm run prepare-bridge && vitest run",
    "covers": "node scripts/render-covers.ts",
    "export": "npm run build && npm run covers && node scripts/export-to-configurator.ts"
  },
  "dependencies": {
    "@omega/webbridge-js": "*",
    "@omega/webbridge-protocol": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
