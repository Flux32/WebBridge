# Корень репозитория: Unity-часть игнорируется своим unity/.gitignore,
# здесь — только общее и артефакты JS-части.

.DS_Store
*.log

# JS/TS (js/webbridge, protocol)
node_modules/
dist/
*.tsbuildinfo
# тарболы релизов собираются npm pack прямо в корне
*.tgz

# IDE
.vs/

# Unity открывает корень репозитория как отдельный проект и сорит артефактами —
# настоящий Unity-проект живёт в unity/ со своим .gitignore.
/[Aa]ssets/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Pp]ackages/
/[Pp]roject[Ss]ettings/
